{
  "name": "personal-librarian-site",
  "version": "0.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "font": "python3 scripts/subset-font.py",
    "dev": "npm run data && vite",
    "build": "npm run data && npm run font && vue-tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mdi/font": "7.0.96",
    "vue": "^3.3.0",
    "vue-router": "^4.3.0",
    "vuetify": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "markdown-it": "^14.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-vuetify": "^2.0.0",
    "vue-tsc": "^2.2.12"
  }
}
